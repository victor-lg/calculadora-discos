{
  "mutate": [
    "app/js/almacenamiento.js",
    "app/js/calculo.js",
    "app/js/entrada.js",
    "app/js/formato.js",
    "app/js/vista.js"
  ],
  "testRunner": "tap",
  "tap": {
    "testFiles": [
      "tests/unit/!(sw).test.js"
    ]
  },
  "concurrency": 4,
  "timeoutMS": 15000,
  "disableTypeChecks": false,
  "reporters": [
    "clear-text"
  ],
  "thresholds": {
    "high": 95,
    "low": 92,
    "break": 90
  }
}
